---
interface Props {
  id?: string;
  label: string;
  title: string;
  description?: string;
}

const { id, label, title, description } = Astro.props;
---

<div class="section-heading">
  <p class="section-heading__label">{label}</p>
  <div>
    <h2 id={id}>{title}</h2>
    {description && <p class="section-heading__description">{description}</p>}
  </div>
</div>
