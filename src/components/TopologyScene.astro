---
/**
 * Interactive 3D topology of the kind of system this site is about: a control plane, the
 * boundaries around it, and the workloads at the edge. Rendered with Three.js on the client,
 * with a static fallback when WebGL is unavailable.
 */
const nodes = [
  { id: 'control', label: 'Control plane', detail: 'Scheduling, run ownership, evidence', tier: 0 },
  { id: 'authz', label: 'Authorization', detail: 'Delegation, policy, execution permits', tier: 1 },
  { id: 'identity', label: 'Identity', detail: 'Subject to principal binding', tier: 1 },
  { id: 'secrets', label: 'Secrets', detail: 'Short-lived, never in images or logs', tier: 1 },
  { id: 'telemetry', label: 'Telemetry', detail: 'Metrics, logs, traces correlated', tier: 1 },
  { id: 'policy', label: 'Policy', detail: 'Narrows authority, never widens it', tier: 1 },
  { id: 'recovery', label: 'Recovery', detail: 'Inspect first, delete only what is owned', tier: 1 },
  { id: 'microvm-a', label: 'MicroVM A', detail: 'Isolated guest, private disk', tier: 2 },
  { id: 'serving', label: 'Model serving', detail: 'Inference behind the boundary', tier: 2 },
  { id: 'agent', label: 'Agent runtime', detail: 'Acts only under delegated authority', tier: 2 },
  { id: 'microvm-b', label: 'MicroVM B', detail: 'Guest-only time control', tier: 2 },
  { id: 'storage', label: 'Storage', detail: 'Durable reservations and evidence', tier: 2 },
  { id: 'edge', label: 'Network edge', detail: 'Segmented ingress and egress', tier: 2 },
];
---

<div class="topology" data-topology>
  <canvas class="topology__canvas" aria-hidden="true"></canvas>
  <div class="topology__label" data-topology-label hidden></div>
  <div class="topology__hud" aria-hidden="true">
    <span class="topology__hud-title"><i class="topology__pulse"></i>system topology</span>
    <span class="topology__hud-hint">drag to rotate · hover a node</span>
  </div>
  <div class="topology__static" aria-hidden="true">
    {nodes.map((node) => (
      <span class:list={['topology__chip', `topology__chip--${node.tier}`]}>{node.label}</span>
    ))}
  </div>
  <ul class="visually-hidden" aria-label="System topology nodes">
    {nodes.map((node) => <li>{node.label}: {node.detail}</li>)}
  </ul>
  <script type="application/json" data-topology-nodes set:html={JSON.stringify(nodes)} />
</div>

<script>
  type ThreeModule = typeof import('three');

  interface NodeSpec { id: string; label: string; detail: string; tier: number }

  interface SceneHandle { dispose: () => void }

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  let active: SceneHandle | null = null;

  function cssColor(name: string, fallback: string): string {
    const value = getComputedStyle(document.documentElement).getPropertyValue(name).trim();
    return value || fallback;
  }

  function layout(specs: NodeSpec[]): [number, number, number][] {
    const tiers = new Map<number, NodeSpec[]>();
    specs.forEach((spec) => tiers.set(spec.tier, [...(tiers.get(spec.tier) ?? []), spec]));
    const radii = [0, 1.55, 2.75];
    return specs.map((spec) => {
      if (spec.tier === 0) return [0, 0, 0];
      const ring = tiers.get(spec.tier)!;
      const index = ring.indexOf(spec);
      const angle = (index / ring.length) * Math.PI * 2 + spec.tier * 0.5;
      const radius = radii[spec.tier] ?? 3;
      const y = spec.tier === 1 ? (index % 2 === 0 ? 0.35 : -0.35) : (index % 2 === 0 ? -0.95 : 0.95);
      return [Math.cos(angle) * radius, y, Math.sin(angle) * radius];
    });
  }

  function buildEdges(specs: NodeSpec[]): [number, number][] {
    const edges: [number, number][] = [];
    const tier1 = specs.map((s, i) => (s.tier === 1 ? i : -1)).filter((i) => i >= 0);
    const tier2 = specs.map((s, i) => (s.tier === 2 ? i : -1)).filter((i) => i >= 0);
    tier1.forEach((i) => edges.push([0, i]));
    tier1.forEach((i, k) => edges.push([i, tier1[(k + 1) % tier1.length]]));
    tier2.forEach((i, k) => {
      edges.push([tier1[k % tier1.length], i]);
      edges.push([i, tier2[(k + 1) % tier2.length]]);
    });
    return edges;
  }

  async function mount(root: HTMLElement): Promise<SceneHandle | null> {
    const canvas = root.querySelector<HTMLCanvasElement>('canvas');
    const label = root.querySelector<HTMLElement>('[data-topology-label]');
    const source = root.querySelector<HTMLScriptElement>('[data-topology-nodes]');
    if (!canvas || !label || !source) return null;

    const specs: NodeSpec[] = JSON.parse(source.textContent ?? '[]');
    let THREE: ThreeModule;
    let renderer: import('three').WebGLRenderer;
    try {
      THREE = await import('three');
      renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true, powerPreference: 'low-power' });
    } catch {
      root.classList.add('is-fallback');
      return null;
    }

    renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
    root.classList.add('is-ready');

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(36, 1, 0.1, 100);
    camera.position.set(0, 0.9, 8.2);
    camera.lookAt(0, 0, 0);

    const group = new THREE.Group();
    group.rotation.x = 0.28;
    scene.add(group);

    const palette = () => ({
      accent: new THREE.Color(cssColor('--accent', '#5fd3ad')),
      accentStrong: new THREE.Color(cssColor('--accent-strong', '#8ae6c8')),
      line: new THREE.Color(cssColor('--line-strong', '#32403a')),
      text: new THREE.Color(cssColor('--text', '#e8eeea')),
      faint: new THREE.Color(cssColor('--faint', '#75817b')),
    });
    let colors = palette();

    const positions = layout(specs);
    const edges = buildEdges(specs);

    // Nodes
    const nodeMaterials: import('three').MeshBasicMaterial[] = [];
    const nodeMeshes = specs.map((spec, i) => {
      const radius = spec.tier === 0 ? 0.26 : spec.tier === 1 ? 0.15 : 0.11;
      const material = new THREE.MeshBasicMaterial({ color: spec.tier === 2 ? colors.text : colors.accent });
      nodeMaterials.push(material);
      const mesh = new THREE.Mesh(new THREE.IcosahedronGeometry(radius, spec.tier === 0 ? 2 : 1), material);
      mesh.position.set(...positions[i]);
      mesh.userData = { index: i, baseScale: 1 };
      group.add(mesh);
      return mesh;
    });

    const haloMaterial = new THREE.MeshBasicMaterial({ color: colors.accent, wireframe: true, transparent: true, opacity: 0.28 });
    const halo = new THREE.Mesh(new THREE.IcosahedronGeometry(0.55, 1), haloMaterial);
    group.add(halo);

    const shellMaterial = new THREE.MeshBasicMaterial({ color: colors.line, wireframe: true, transparent: true, opacity: 0.14 });
    const shell = new THREE.Mesh(new THREE.SphereGeometry(3.35, 22, 14), shellMaterial);
    group.add(shell);

    // Edges
    const edgePositions = new Float32Array(edges.length * 6);
    edges.forEach(([a, b], i) => {
      edgePositions.set(positions[a], i * 6);
      edgePositions.set(positions[b], i * 6 + 3);
    });
    const edgeGeometry = new THREE.BufferGeometry();
    edgeGeometry.setAttribute('position', new THREE.BufferAttribute(edgePositions, 3));
    const edgeMaterial = new THREE.LineBasicMaterial({ color: colors.line, transparent: true, opacity: 0.7 });
    group.add(new THREE.LineSegments(edgeGeometry, edgeMaterial));

    // Packets travelling along edges
    const packetMaterial = new THREE.MeshBasicMaterial({ color: colors.accentStrong });
    const packetGeometry = new THREE.SphereGeometry(0.045, 8, 8);
    const packets = Array.from({ length: reduceMotion.matches ? 0 : 9 }, () => {
      const mesh = new THREE.Mesh(packetGeometry, packetMaterial);
      group.add(mesh);
      return { mesh, edge: Math.floor(Math.random() * edges.length), t: Math.random(), speed: 0.25 + Math.random() * 0.3, forward: Math.random() > 0.5 };
    });

    const from = new THREE.Vector3();
    const to = new THREE.Vector3();

    // Interaction state
    const raycaster = new THREE.Raycaster();
    const pointer = new THREE.Vector2(-10, -10);
    let hovered: import('three').Mesh | null = null;
    let dragging = false;
    let lastX = 0;
    let lastY = 0;
    let velocityY = 0;
    let velocityX = 0;
    let idleTime = 0;
    let width = 1;
    let height = 1;

    const resize = () => {
      const rect = root.getBoundingClientRect();
      width = Math.max(1, rect.width);
      height = Math.max(1, rect.height);
      renderer.setSize(width, height, false);
      camera.aspect = width / height;
      camera.updateProjectionMatrix();
    };
    resize();
    const resizeObserver = new ResizeObserver(resize);
    resizeObserver.observe(root);

    const onPointerMove = (event: PointerEvent) => {
      const rect = canvas.getBoundingClientRect();
      pointer.x = ((event.clientX - rect.left) / rect.width) * 2 - 1;
      pointer.y = -((event.clientY - rect.top) / rect.height) * 2 + 1;
      if (dragging) {
        const dx = event.clientX - lastX;
        const dy = event.clientY - lastY;
        lastX = event.clientX;
        lastY = event.clientY;
        velocityY = dx * 0.006;
        velocityX = dy * 0.004;
        group.rotation.y += velocityY;
        group.rotation.x = Math.max(-0.9, Math.min(0.9, group.rotation.x + velocityX));
        idleTime = 0;
      }
    };
    const onPointerDown = (event: PointerEvent) => {
      dragging = true;
      lastX = event.clientX;
      lastY = event.clientY;
      canvas.setPointerCapture(event.pointerId);
      root.classList.add('is-dragging');
    };
    const onPointerUp = (event: PointerEvent) => {
      dragging = false;
      if (canvas.hasPointerCapture(event.pointerId)) canvas.releasePointerCapture(event.pointerId);
      root.classList.remove('is-dragging');
    };
    const onPointerLeave = () => {
      pointer.set(-10, -10);
    };

    canvas.addEventListener('pointermove', onPointerMove);
    canvas.addEventListener('pointerdown', onPointerDown);
    canvas.addEventListener('pointerup', onPointerUp);
    canvas.addEventListener('pointercancel', onPointerUp);
    canvas.addEventListener('pointerleave', onPointerLeave);

    const setHovered = (mesh: import('three').Mesh | null) => {
      if (hovered === mesh) return;
      hovered = mesh;
      root.classList.toggle('is-hovering', mesh !== null);
      if (!mesh) {
        label.hidden = true;
        return;
      }
      const spec = specs[mesh.userData.index as number];
      label.innerHTML = `<strong>${spec.label}</strong><span>${spec.detail}</span>`;
      label.hidden = false;
    };

    const projected = new THREE.Vector3();
    const placeLabel = () => {
      if (!hovered) return;
      hovered.getWorldPosition(projected);
      projected.project(camera);
      const x = (projected.x * 0.5 + 0.5) * width;
      const y = (-projected.y * 0.5 + 0.5) * height;
      label.style.transform = `translate(${Math.round(x)}px, ${Math.round(y)}px)`;
    };

    const applyTheme = () => {
      colors = palette();
      nodeMeshes.forEach((mesh, i) => nodeMaterials[i].color.copy(specs[i].tier === 2 ? colors.text : colors.accent));
      haloMaterial.color.copy(colors.accent);
      shellMaterial.color.copy(colors.line);
      edgeMaterial.color.copy(colors.line);
      packetMaterial.color.copy(colors.accentStrong);
    };
    const themeObserver = new MutationObserver(applyTheme);
    themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
    const schemeQuery = window.matchMedia('(prefers-color-scheme: dark)');
    schemeQuery.addEventListener('change', applyTheme);

    // Render loop, paused when off-screen or the tab is hidden
    let frame = 0;
    let running = false;
    let visible = false;
    let last = performance.now();
    const clock = { t: 0 };

    const tick = (now: number) => {
      if (!running) return;
      const dt = Math.min(0.05, (now - last) / 1000);
      last = now;
      clock.t += dt;
      idleTime += dt;

      if (!dragging) {
        velocityY *= 0.92;
        velocityX *= 0.9;
        group.rotation.y += velocityY;
        group.rotation.x += velocityX;
        if (!reduceMotion.matches && idleTime > 1.2) {
          group.rotation.y += dt * 0.12;
        }
      }

      halo.rotation.y -= dt * 0.35;
      halo.rotation.x += dt * 0.2;
      shell.rotation.y += dt * 0.02;

      packets.forEach((packet) => {
        packet.t += dt * packet.speed;
        if (packet.t >= 1) {
          const [a, b] = edges[packet.edge];
          const end = packet.forward ? b : a;
          const candidates = edges.map((e, i) => (e[0] === end || e[1] === end ? i : -1)).filter((i) => i >= 0 && i !== packet.edge);
          packet.edge = candidates[Math.floor(Math.random() * candidates.length)] ?? packet.edge;
          packet.forward = edges[packet.edge][0] === end;
          packet.t = 0;
        }
        const [a, b] = edges[packet.edge];
        from.set(...positions[packet.forward ? a : b]);
        to.set(...positions[packet.forward ? b : a]);
        packet.mesh.position.lerpVectors(from, to, packet.t);
      });

      nodeMeshes.forEach((mesh, i) => {
        const target = mesh === hovered ? 1.45 : 1;
        const s = mesh.scale.x + (target - mesh.scale.x) * 0.18;
        mesh.scale.setScalar(s);
        if (specs[i].tier === 0) {
          const pulse = 1 + Math.sin(clock.t * 2.2) * 0.04;
          mesh.scale.setScalar(s * pulse);
        }
      });

      if (!dragging) {
        raycaster.setFromCamera(pointer, camera);
        const hit = raycaster.intersectObjects(nodeMeshes, false)[0];
        setHovered(hit ? (hit.object as import('three').Mesh) : null);
      }
      placeLabel();

      renderer.render(scene, camera);
      frame = requestAnimationFrame(tick);
    };

    const start = () => {
      if (running || !visible || document.hidden) return;
      running = true;
      last = performance.now();
      frame = requestAnimationFrame(tick);
    };
    const stop = () => {
      running = false;
      cancelAnimationFrame(frame);
    };

    const visibility = new IntersectionObserver((entries) => {
      visible = entries.some((entry) => entry.isIntersecting);
      visible ? start() : stop();
    }, { threshold: 0.05 });
    visibility.observe(root);
    const onVisibilityChange = () => (document.hidden ? stop() : start());
    document.addEventListener('visibilitychange', onVisibilityChange);

    // Render one frame immediately so the scene is visible even before observers fire.
    renderer.render(scene, camera);

    return {
      dispose() {
        stop();
        visibility.disconnect();
        resizeObserver.disconnect();
        themeObserver.disconnect();
        schemeQuery.removeEventListener('change', applyTheme);
        document.removeEventListener('visibilitychange', onVisibilityChange);
        canvas.removeEventListener('pointermove', onPointerMove);
        canvas.removeEventListener('pointerdown', onPointerDown);
        canvas.removeEventListener('pointerup', onPointerUp);
        canvas.removeEventListener('pointercancel', onPointerUp);
        canvas.removeEventListener('pointerleave', onPointerLeave);
        scene.traverse((object) => {
          const mesh = object as import('three').Mesh;
          if (mesh.geometry) mesh.geometry.dispose();
          const material = mesh.material as import('three').Material | undefined;
          if (material) material.dispose();
        });
        renderer.dispose();
      },
    };
  }

  async function init() {
    const root = document.querySelector<HTMLElement>('[data-topology]');
    if (!root || root.dataset.ready === 'true') return;
    root.dataset.ready = 'true';
    active = await mount(root);
  }

  document.addEventListener('astro:before-swap', () => {
    active?.dispose();
    active = null;
  });

  init();
  document.addEventListener('astro:page-load', init);
</script>
