---
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../utils/paths';

interface Props {
  article: CollectionEntry<'writing'>;
}

const { article } = Astro.props;
const { title, slug, description, published, tags, draft } = article.data;
const date = published.toLocaleDateString('en-GB', {
  day: '2-digit',
  month: 'short',
  year: 'numeric',
});
---

<li class="writing-item" data-reveal>
  <div class="writing-item__main">
    <h3>
      <a href={withBase(`writing/${slug}/`)}>{title}</a>
      {draft && <span class="draft-label">Draft</span>}
    </h3>
    <p>{description}</p>
  </div>
  <div class="writing-item__meta">
    <time datetime={published.toISOString()}>{date}</time>
    {tags.length > 0 && <div>{tags.join(' · ')}</div>}
    <span class="writing-item__arrow" aria-hidden="true">→</span>
  </div>
</li>
