---
interface Props {
  items: string[];
  label?: string;
}

const { items, label = 'Areas of practice' } = Astro.props;
const track = [...items, ...items];
---

<div class="ticker" aria-label={label}>
  <div class="ticker__track" aria-hidden="true">
    {track.map((item) => (
      <span class="ticker__item">{item}<i class="ticker__sep"></i></span>
    ))}
  </div>
  <ul class="visually-hidden">
    {items.map((item) => <li>{item}</li>)}
  </ul>
</div>
