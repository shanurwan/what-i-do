---
import ContactCta from '../components/ContactCta.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { profile } from '../config/profile';
import { experience, principles } from '../data/experience';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About" description={`${profile.name}: ${profile.role} at ${profile.company}. Infrastructure and security engineering for AI systems, with independent systems work on authorization and isolation.`}>
  <div class="shell">
    <header class="page-header page-header--about">
      <p class="eyebrow" data-reveal>About</p>
      <h1 data-reveal style="--reveal-delay: 80ms">I’m {profile.name}. I build AI infrastructure that has to stay up and stay correct.</h1>
      <p class="page-header__lede" data-reveal style="--reveal-delay: 160ms">
        {profile.role} at {profile.company}, {profile.location}. I work on high-criticality systems where platform
        engineering, security, and reliability meet, and where a wrong answer is as serious as an outage.
      </p>
    </header>

    <section class="about-intro" aria-labelledby="about-me-heading">
      <div class="about-intro__body" data-reveal>
        <h2 id="about-me-heading" class="visually-hidden">About me</h2>
        <p>
          I own the infrastructure and security layer for AI workloads at {profile.company}: the Kubernetes and
          cloud platforms they run on, the identity and authorization boundaries that protect them, the observability
          that shows what they are doing, and the recovery paths that bring them back. My job is to make sure the
          system keeps running and keeps giving correct answers under pressure, not just in a design review.
        </p>
        <p>
          The work that shaped how I think happens below the usual abstractions. In NEST AuthZ I modelled delegated
          authority as typed data so approval, revalidation, and execution stay separate and fail closed. In Epoch I
          moved time inside Firecracker microVMs on bare-metal KVM so expiry and scheduling logic can be tested without
          touching the host clock. Both projects ship with threat models, invariants, and pinned evidence rather than
          claims.
        </p>
        <p>
          I care about boundaries: who holds authority, what a component is allowed to assume, what happens when a
          step is interrupted, and what evidence remains afterwards. That is the lens I bring to platform design,
          security review, and incident work alike.
        </p>
      </div>
      <aside class="about-facts" aria-label="Profile summary" data-reveal style="--reveal-delay: 120ms">
        <dl>
          <div><dt>Name</dt><dd>{profile.name}</dd></div>
          <div><dt>Role</dt><dd>{profile.role}</dd></div>
          <div><dt>Company</dt><dd>{profile.company}</dd></div>
          <div><dt>Based</dt><dd>{profile.location}</dd></div>
          <div><dt>Focus</dt><dd>High-criticality AI platforms, security boundaries, uptime</dd></div>
          {profile.email && <div><dt>Email</dt><dd><a href={`mailto:${profile.email}`}>{profile.email}</a></dd></div>}
          {profile.phone && <div><dt>Phone</dt><dd><a href={`tel:${profile.phone.replace(/[^+\d]/g, '')}`}>{profile.phone}</a></dd></div>}
          <div><dt>Status</dt><dd>{profile.availability}</dd></div>
        </dl>
        <ul class="about-facts__links">
          <li><a href={profile.github} rel="me">GitHub <span aria-hidden="true">↗</span></a></li>
          {profile.linkedin && <li><a href={profile.linkedin} rel="me">LinkedIn <span aria-hidden="true">↗</span></a></li>}
          {profile.resume && <li><a href={profile.resume}>Résumé <span aria-hidden="true">↗</span></a></li>}
        </ul>
      </aside>
    </section>

    <section class="section" aria-labelledby="experience-heading">
      <SectionHeading
        id="experience-heading"
        label="01 / Experience"
        title="Production responsibility, backed by independent systems work."
      />
      <ol class="timeline">
        {experience.map((entry, index) => (
          <li class:list={['timeline__entry', `timeline__entry--${entry.kind}`]} data-reveal style={`--reveal-delay: ${index * 80}ms`}>
            <div class="timeline__period">
              <span>{entry.period}</span>
              <span class="timeline__kind">{entry.kind === 'role' ? 'Role' : 'Project'}</span>
            </div>
            <div class="timeline__content">
              <h3>
                {entry.url ? <a href={entry.url}>{entry.title}</a> : entry.title}
              </h3>
              <p class="timeline__org">{entry.organisation}</p>
              <p class="timeline__summary">{entry.summary}</p>
              <ul class="case-list">
                {entry.highlights.map((item) => <li>{item}</li>)}
              </ul>
              <ul class="tag-list" aria-label="Technologies">
                {entry.stack.map((item) => <li>{item}</li>)}
              </ul>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="section" aria-labelledby="how-heading">
      <SectionHeading
        id="how-heading"
        label="02 / How I work"
        title="Principles I hold the systems to."
      />
      <div class="principle-grid">
        {principles.map((principle, index) => (
          <article class="principle" data-reveal style={`--reveal-delay: ${index * 80}ms`}>
            <h3>{principle.title}</h3>
            <p>{principle.body}</p>
          </article>
        ))}
      </div>
    </section>

    <ContactCta showAbout={false} />
  </div>
</BaseLayout>
