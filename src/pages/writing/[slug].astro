---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const articles = await getCollection('writing', ({ data }) => import.meta.env.DEV || !data.draft);
  return articles.map((article) => ({
    params: { slug: article.data.slug },
    props: { article },
  }));
}

interface Props {
  article: CollectionEntry<'writing'>;
}

const { article } = Astro.props;
const { Content } = await render(article);
const { title, description, published, updated, tags, draft, canonicalUrl } = article.data;
const formatDate = (date: Date) => date.toLocaleDateString('en-GB', {
  day: '2-digit',
  month: 'long',
  year: 'numeric',
});
---

<BaseLayout
  title={title}
  description={description}
  type="article"
  published={published}
  canonicalUrl={canonicalUrl}
  noindex={draft}
>
  <article class="shell">
    <header class="page-header">
      <ul class="article-meta">
        <li><time datetime={published.toISOString()}>{formatDate(published)}</time></li>
        {updated && <li>Updated <time datetime={updated.toISOString()}>{formatDate(updated)}</time></li>}
        {tags.map((tag) => <li>{tag}</li>)}
        {draft && <li>Draft — local preview only</li>}
      </ul>
      <h1>{title}</h1>
      <p class="page-header__lede">{description}</p>
    </header>
    <div class="prose"><Content /></div>
  </article>
</BaseLayout>
