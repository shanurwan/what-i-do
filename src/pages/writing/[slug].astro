---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const articles = await getCollection('writing', ({ data }) => import.meta.env.DEV || !data.draft);
  return articles.map((article) => ({
    params: { slug: article.data.slug },
    props: { article },
  }));
}

interface Props {
  article: CollectionEntry<'writing'>;
}

const { article } = Astro.props;
const { Content, headings } = await render(article);
const { title, subtitle, description, published, updated, tags, draft, canonicalUrl, presentation } = article.data;
const formatDate = (date: Date) => date.toLocaleDateString('en-GB', {
  day: '2-digit',
  month: 'long',
  year: 'numeric',
});

const isCourse = presentation === 'course';
const modules = headings.filter((heading) => heading.depth === 2);
const wordCount = (article.body ?? '').split(/\s+/).filter(Boolean).length;
const readingMinutes = Math.max(5, Math.round(wordCount / 180));
---

<BaseLayout
  title={title}
  description={description}
  type="article"
  published={published}
  canonicalUrl={canonicalUrl}
  noindex={draft}
>
  {isCourse ? (
    <article class="course" data-course>
      <div class="course-progress" aria-hidden="true"><i data-course-progress></i></div>
      <header class="course__hero">
        <div class="course__hero-backdrop" aria-hidden="true"></div>
        <div class="shell course__hero-inner">
          <ul class="article-meta" data-reveal>
            <li>{modules.length} parts</li>
            <li>~{readingMinutes} min</li>
            <li><time datetime={published.toISOString()}>{formatDate(published)}</time></li>
            {updated && <li>Updated <time datetime={updated.toISOString()}>{formatDate(updated)}</time></li>}
            {draft && <li>Draft — local preview only</li>}
          </ul>
          <h1 data-reveal style="--reveal-delay: 80ms">{title}</h1>
          <p class="page-header__lede" data-reveal style="--reveal-delay: 160ms">{subtitle ?? description}</p>
          <div class="course__hero-actions" data-reveal style="--reveal-delay: 240ms">
            {modules[0] && <a class="button button--primary" href={`#${modules[0].slug}`}>Start reading <span aria-hidden="true">↓</span></a>}
            {tags.length > 0 && (
              <ul class="tag-list" aria-label="Topics">
                {tags.map((tag) => <li>{tag}</li>)}
              </ul>
            )}
          </div>
        </div>
      </header>

      <div class="shell course__layout">
        <aside class="course__sidebar">
          <nav class="course__outline" aria-label="Contents">
            <p class="eyebrow">Contents</p>
            <ol>
              {modules.map((module, index) => (
                <li>
                  <a href={`#${module.slug}`} data-course-link={module.slug}>
                    <span class="course__outline-index">{String(index + 1).padStart(2, '0')}</span>
                    <span class="course__outline-text">{module.text}</span>
                  </a>
                </li>
              ))}
            </ol>
          </nav>
        </aside>
        <div class="prose prose--course" data-course-body><Content /></div>
      </div>
    </article>
  ) : (
    <article class="shell">
      <header class="page-header">
        <ul class="article-meta">
          <li><time datetime={published.toISOString()}>{formatDate(published)}</time></li>
          {updated && <li>Updated <time datetime={updated.toISOString()}>{formatDate(updated)}</time></li>}
          {tags.map((tag) => <li>{tag}</li>)}
          {draft && <li>Draft — local preview only</li>}
        </ul>
        <h1>{title}</h1>
        <p class="page-header__lede">{subtitle ?? description}</p>
      </header>
      <div class:list={["prose", { "prose--evidence": presentation === 'evidence' }]}><Content /></div>
    </article>
  )}
</BaseLayout>

<script>
  function setupCourse() {
    const root = document.querySelector<HTMLElement>('[data-course]');
    if (!root || root.dataset.ready === 'true') return;
    root.dataset.ready = 'true';

    const bar = root.querySelector<HTMLElement>('[data-course-progress]');
    const body = root.querySelector<HTMLElement>('[data-course-body]');
    const links = Array.from(root.querySelectorAll<HTMLAnchorElement>('[data-course-link]'));
    if (!bar || !body) return;

    const updateProgress = () => {
      const rect = body.getBoundingClientRect();
      const total = rect.height - window.innerHeight;
      const scrolled = Math.min(Math.max(-rect.top, 0), Math.max(total, 1));
      bar.style.transform = `scaleX(${(scrolled / Math.max(total, 1)).toFixed(4)})`;
    };
    updateProgress();
    window.addEventListener('scroll', updateProgress, { passive: true });
    window.addEventListener('resize', updateProgress);

    const headings = Array.from(body.querySelectorAll<HTMLElement>('h2[id]'));
    if (headings.length === 0 || !('IntersectionObserver' in window)) return;
    const setActive = (id: string) => {
      links.forEach((link) => link.classList.toggle('is-active', link.dataset.courseLink === id));
    };
    const observer = new IntersectionObserver((entries) => {
      const visible = entries.filter((entry) => entry.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
      if (visible[0]) setActive(visible[0].target.id);
    }, { rootMargin: '-15% 0px -70% 0px', threshold: 0 });
    headings.forEach((heading) => observer.observe(heading));
    setActive(headings[0].id);
  }

  setupCourse();
  document.addEventListener('astro:page-load', setupCourse);
</script>
