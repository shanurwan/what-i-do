---
import { getCollection } from 'astro:content';
import WritingItem from '../../components/WritingItem.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const articles = (await getCollection('writing', ({ data }) => import.meta.env.DEV || !data.draft))
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());
---

<BaseLayout title="Writing" description="Technical writing on infrastructure, authorization, reliability, isolation, and recovery.">
  <div class="shell">
    <header class="page-header">
      <p class="eyebrow" data-reveal>Writing / Technical notes</p>
      <h1 data-reveal style="--reveal-delay: 80ms">Reasoning about systems in the open.</h1>
      <p class="page-header__lede" data-reveal style="--reveal-delay: 160ms">
        Technical notes on infrastructure behaviour, security boundaries, testing, and recovery. Each article is
        backed by pinned, reproducible evidence.
      </p>
    </header>
    <section class="section section--flush" aria-label="Writing archive">
      {articles.length > 0 ? (
        <ul class="writing-list">{articles.map((article) => <WritingItem article={article} />)}</ul>
      ) : (
        <p class="empty-state">No public articles yet. The writing system is ready for the first published note.</p>
      )}
    </section>
  </div>
</BaseLayout>
