---
import { getCollection } from 'astro:content';
import ContactCta from '../components/ContactCta.astro';
import FailureExplorer from '../components/FailureExplorer.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Ticker from '../components/Ticker.astro';
import TopologyScene from '../components/TopologyScene.astro';
import WritingItem from '../components/WritingItem.astro';
import { profile } from '../config/profile';
import { capabilities, principles } from '../data/experience';
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../utils/paths';

const projects = (await getCollection('projects'))
  .filter(({ data }) => data.featured)
  .sort((a, b) => a.data.order - b.data.order);
const articles = (await getCollection('writing', ({ data }) => !data.draft))
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf())
  .slice(0, 3);

const tickerItems = [
  'Kubernetes',
  'Cloud platforms',
  'Linux',
  'Firecracker / KVM',
  'Authorization',
  'Threat modelling',
  'Observability',
  'Incident response',
  'Capacity & cost',
  'MLOps integration',
  'Go',
  'Python',
  'Recovery engineering',
];
---

<BaseLayout description="Infrastructure and security engineering for high-criticality AI systems: platform, authorization boundaries, isolation, uptime, and recovery, documented with evidence.">
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero__backdrop" aria-hidden="true"></div>
    <div class="shell hero__inner">
      <div class="hero__copy">
        <p class="hero__kicker" data-reveal>
          <span class="hero__status"><i></i>{profile.role} · {profile.company}</span>
        </p>
        <h1 id="hero-title" data-reveal style="--reveal-delay: 80ms">
          I build high-integrity infrastructure for AI systems that must stay up.
        </h1>
        <p class="hero__lede" data-reveal style="--reveal-delay: 160ms">
          Platform, security boundaries, and reliability for high-criticality AI workloads: what they run on, what
          protects them, how they stay correct, and how they recover. Alongside that, I build reference systems that
          make hard infrastructure behaviour inspectable.
        </p>
        <div class="hero__actions" data-reveal style="--reveal-delay: 240ms">
          <a class="button button--primary" href={withBase('projects/')}>View case studies <span aria-hidden="true">→</span></a>
          <a class="button" href={withBase('about/')}>About me</a>
        </div>
        <dl class="hero__facts" data-reveal style="--reveal-delay: 320ms">
          <div><dt>Focus</dt><dd>High-criticality AI infrastructure</dd></div>
          <div><dt>Based</dt><dd>{profile.location}</dd></div>
          <div><dt>Method</dt><dd>Evidence-backed engineering</dd></div>
        </dl>
      </div>
      <div class="hero__panel" data-reveal style="--reveal-delay: 200ms">
        <TopologyScene />
      </div>
    </div>
  </section>

  <Ticker items={tickerItems} />

  <div class="shell">
    <section class="section" aria-labelledby="capabilities-heading">
      <SectionHeading
        id="capabilities-heading"
        label="01 / What I do"
        title="Infrastructure for AI systems where downtime and wrong answers both count as failure."
        description="Four areas of practice, each one measured by what the system does under load, under attack, and after failure."
      />
      <div class="capability-grid">
        {capabilities.map((capability, index) => (
          <article class="capability" data-reveal data-tilt style={`--reveal-delay: ${index * 80}ms`}>
            <span class="capability__index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <h3>{capability.title}</h3>
            <p>{capability.summary}</p>
            <ul class="capability__points">
              {capability.points.map((point) => <li>{point}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </section>

    <section class="section" aria-labelledby="failure-heading">
      <SectionHeading
        id="failure-heading"
        label="02 / Under failure"
        title="What the systems do when something goes wrong."
        description="Pick a failure mode to see how it is detected, contained, and recorded. Every entry comes from behaviour documented in the project evidence."
      />
      <div data-reveal>
        <FailureExplorer />
      </div>
    </section>

    <section class="section" aria-labelledby="work-heading">
      <SectionHeading
        id="work-heading"
        label="03 / Selected work"
        title="Systems built to make difficult infrastructure behaviour inspectable."
        description="Case studies cover constraints, decisions, failure modes, and the evidence each claim rests on."
        actionHref={withBase('projects/')}
        actionLabel="All work"
      />
      <div class="project-grid">
        {projects.map((project, index) => <ProjectCard project={project} index={index} compact />)}
      </div>
    </section>

    <section class="section" aria-labelledby="writing-heading">
      <SectionHeading
        id="writing-heading"
        label="04 / Writing"
        title="Notes on authorization, isolation, reliability, and recovery."
        actionHref={withBase('writing/')}
        actionLabel="Writing archive"
      />
      {articles.length > 0 ? (
        <ul class="writing-list">
          {articles.map((article) => <WritingItem article={article} />)}
        </ul>
      ) : (
        <p class="empty-state">No public articles yet. Drafts remain local until they are ready to publish.</p>
      )}
    </section>

    <section class="section" aria-labelledby="principles-heading">
      <SectionHeading
        id="principles-heading"
        label="05 / How I work"
        title="Principles I hold the systems to."
      />
      <div class="principle-grid">
        {principles.map((principle, index) => (
          <article class="principle" data-reveal data-tilt style={`--reveal-delay: ${index * 80}ms`}>
            <h3>{principle.title}</h3>
            <p>{principle.body}</p>
          </article>
        ))}
      </div>
    </section>

    <ContactCta />
  </div>
</BaseLayout>
