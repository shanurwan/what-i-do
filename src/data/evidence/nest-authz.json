    {
      "id": "failure-restart-semantics",
      "number": 6,
      "title": "Failure and restart semantics",
      "description": "The durable SQLite reference adapter has explicit restart and terminal-state tests. This is a bounded local persistence claim, not distributed exactly-once execution.",
      "invariant": "Retry and recovery behavior must preserve one execution identity while surfacing uncertainty about external side effects.",
      "presentation": "evidence-card",
      "cases": [
        {
          "id": "durable-local-boundary",
          "label": "Documented local boundary",
          "input": {
            "tested": [
              "reopening the store preserves records",
              "a new store instance cannot bypass durable uniqueness",
              "SUCCEEDED and FAILED are terminal",
              "an abandoned RESERVED record requires application-specific reconciliation"
            ]
          },
          "outcome": "LOCAL DURABILITY TESTED",
          "reason": "NO GLOBAL EXACTLY-ONCE CLAIM",
          "explanation": "NEST AuthZ can prevent a second local reservation for one exact permit in one authoritative SQLite database. It cannot atomically coordinate that database with an arbitrary external side effect.",
          "trace": []
        }
      ],
