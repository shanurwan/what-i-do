      "id": "canonical-semantics",
      "number": 4,
      "title": "Canonical semantics",
      "description": "The two values compare loosely in Python, but NEST AuthZ gives them different type tags, canonical bytes, and content digests.",
      "invariant": "Canonical representation is part of the security protocol when evidence crosses process or system boundaries.",
      "presentation": "comparison",
      "cases": [
        {
          "id": "integer-one",
          "label": "Integer 1",
          "input": {"x": 1, "pythonType": "int", "canonicalTag": "I"},
          "outcome": "sha256:64dedf7d59d643c1f23e6a79023290cf13f08fd380f733e91eac2fcbb0d10c0d",
          "reason": "INTEGER",
          "explanation": "The integer uses the canonical I tag and has its own typed RequestContext identity.",
          "trace": []
        },
        {
          "id": "boolean-true",
          "label": "Boolean true",
          "input": {"x": true, "pythonType": "bool", "canonicalTag": "B"},
          "outcome": "sha256:a5d05bd70daa4dbdad89e4822788bb70f41eaea5b386159f77e799dcea11da27",
          "reason": "BOOLEAN",
          "explanation": "The boolean uses the canonical B tag. In an equality condition expecting integer 1, this type mismatch is ERROR and the decision fails closed to DENY.",
          "trace": []
        }
      ],
